  "skills": [
    {
      "skillId": "cedros-pay:checkout",
      "name": "Checkout",
      "visibility": "public",
      "category": "commerce",
      "docsSource": "manifest.surfaces.ai.skills",
      "runtimeBehavior": "Discovery documentation only. Canonical checkout and versioned-cart execution uses the registered Cedros Pay 5.0.8 Wasm routes and fails closed until the exact eighteen-model guarded-policy marker validates."
    },
    {
      "skillId": "cedros-pay:subscriptions",
      "name": "Subscriptions",
      "visibility": "authenticated",
      "category": "billing",
      "docsSource": "manifest.surfaces.ai.skills",
      "runtimeBehavior": "Discovery documentation only; subscription execution is through the self-serve Wasm subscription routes."
    },
    {
      "skillId": "cedros-pay:admin",
      "name": "Admin",
      "visibility": "admin",
      "category": "admin",
      "docsSource": "manifest.surfaces.ai.skills",
      "runtimeBehavior": "Discovery documentation only; implemented admin execution uses the Wasm admin routes with Cedros Login admin auth. Returns are persisted in the guarded commerce ledger with validated lifecycle transitions. Reserved dispute compatibility routes remain unsupported, hidden by the packaged admin UI, and fail closed with 501 not_implemented."
    }
  ],
