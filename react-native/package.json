{
  "name": "@cedros/pay-react-native",
  "version": "3.0.0",
  "description": "React Native library for Cedros Pay - unified Stripe and Solana x402 payments",
  "main": "./lib/index.js",
  "module": "./esm/index.js",
  "react-native": "./lib/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "react-native": "./lib/index.js",
      "import": "./esm/index.js",
      "require": "./lib/index.js"
    },
    "./checkout": {
      "types": "./types/canonicalCheckout.d.ts",
      "react-native": "./lib/canonicalCheckout.js",
      "import": "./esm/canonicalCheckout.js",
      "require": "./lib/canonicalCheckout.js"
    },
    "./register": {
      "types": "./types/register.d.ts",
      "react-native": "./lib/register.js",
      "import": "./esm/register.js",
      "require": "./lib/register.js"
    }
  },
  "files": [
    "lib",
    "esm",
    "types",
    "src/i18n/translations"
  ],
  "keywords": [
    "payments",
    "stripe",
    "solana",
    "x402",
    "crypto",
    "react-native",
    "mobile",
    "stablecoins",
    "in-app-purchase",
    "storekit",
    "play-billing"
  ],
  "author": "Cedros Pay Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/conorholds/cedros-pay.git",
    "directory": "ui/react-native"
  },
  "peerDependencies": {
    "@solana/spl-token": "^0.4.14",
    "@solana/wallet-adapter-base": "^0.9.23",
    "@solana/wallet-adapter-phantom": "^0.9.24",
    "@solana/wallet-adapter-react": "^0.15.35",
    "@solana/wallet-adapter-solflare": "^0.6.28",
    "@solana/web3.js": "^1.95.0",
    "@stripe/stripe-react-native": "^0.41.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-native": ">=0.72.0 <1.0.0"
  },
  "peerDependenciesMeta": {
    "@stripe/stripe-react-native": {
      "optional": false
    }
  },
  "dependencies": {
    "@noble/hashes": "1.8.0",
    "bs58": "6.0.0",
    "js-base64": "3.7.8",
    "react-native-iap": "13.0.4"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@react-native/babel-preset": "0.85.3",
    "@solana/spl-token": "0.4.14",
    "@solana/wallet-adapter-base": "0.9.23",
    "@solana/wallet-adapter-phantom": "0.9.24",
    "@solana/wallet-adapter-react": "0.15.35",
    "@solana/wallet-adapter-solflare": "0.6.28",
    "@solana/web3.js": "1.98.4",
    "@stripe/stripe-react-native": "0.41.0",
    "@types/jest": "30.0.0",
    "@types/react": "19.2.15",
    "@typescript-eslint/eslint-plugin": "8.60.1",
    "@typescript-eslint/parser": "8.60.1",
    "bigint-buffer": "file:../vendor/bigint-buffer",
    "esbuild": "0.28.1",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.6.0",
    "metro": "0.84.4",
    "metro-config": "0.84.4",
    "react": "19.2.6",
    "react-native": "0.85.3",
    "typescript": "5.9.3"
  },
  "overrides": {
    "bigint-buffer": "file:../vendor/bigint-buffer",
    "jayson": {
      "uuid": "11.1.1"
    }
  },
  "scripts": {
    "clean": "rm -rf lib esm types",
    "build": "npm run clean && npm run build:lib && npm run build:esm && npm run build:types && npm run build:copy-translations",
    "build:lib": "tsc -p tsconfig.json --outDir lib --module commonjs --jsx react-jsx --noUnusedLocals false",
    "build:esm": "node scripts/build-esm.mjs",
    "build:types": "tsc -p tsconfig.json --outDir types --declaration --emitDeclarationOnly",
    "build:copy-translations": "mkdir -p lib/i18n/translations esm/i18n/translations && cp -R src/i18n/translations/. lib/i18n/translations/ && cp -R src/i18n/translations/. esm/i18n/translations/",
    "lint": "eslint src",
    "type-check": "tsc --noEmit",
    "test": "npm run build:lib && node --test tests/*.test.cjs",
    "sync:extension-manifest": "node scripts/sync-extension-manifest.mjs",
    "check:extension-manifest": "node scripts/sync-extension-manifest.mjs --check",
    "check:checkout-contract": "node ../scripts/sync-checkout-contract-fixtures.mjs --check",
    "verify:exports": "node scripts/verify-package-exports.mjs",
    "verify:consumers": "node scripts/verify-package-consumers.mjs",
    "ci:checks": "npm run check:extension-manifest && npm run check:checkout-contract && npm run lint && npm run type-check && npm test && npm run build && npm run verify:exports && npm run verify:consumers",
    "prepublishOnly": "npm run ci:checks",
    "prepack": "npm run check:extension-manifest && npm run check:checkout-contract && npm run build && npm run verify:exports && npm run verify:consumers"
  },
  "directories": {
    "lib": "lib",
    "test": "tests"
  },
  "bugs": {
    "url": "https://github.com/conorholds/cedros-pay/issues"
  },
  "homepage": "https://github.com/conorholds/cedros-pay#readme",
  "packageManager": "npm@11.13.0"
}
