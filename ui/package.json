{
  "name": "@cedros/pay-react",
  "version": "5.0.8",
  "description": "Private admin and web runtime for the Cedros Pay extension",
  "exports": {
    "./admin/register": {
      "types": "./dist/admin/register.d.ts",
      "import": "./dist/admin/register.mjs",
      "require": "./dist/admin/register.js"
    },
    "./web/register": {
      "types": "./dist/web/register.d.ts",
      "import": "./dist/web/register.mjs",
      "require": "./dist/web/register.js"
    },
    "./style.css": "./dist/pay-react.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "author": "Cedros Pay Team",
  "license": "LicenseRef-PILL-1.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/conorholds/cedros-pay.git",
    "directory": "ui"
  },
  "bugs": {
    "url": "https://github.com/conorholds/cedros-pay/issues"
  },
  "homepage": "https://github.com/conorholds/cedros-pay/tree/main/ui#readme",
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "buffer": "6.0.3",
    "motion": "12.42.2"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "14.3.1",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.10.0",
    "@types/react": "18.3.26",
    "@types/react-dom": "18.3.7",
    "@typescript-eslint/eslint-plugin": "8.60.1",
    "@typescript-eslint/parser": "8.60.1",
    "@vitejs/plugin-react": "4.7.0",
    "@vitest/coverage-v8": "4.1.11",
    "autoprefixer": "10.4.23",
    "bigint-buffer": "file:./vendor/bigint-buffer",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.6.0",
    "husky": "9.1.7",
    "image-size": "file:./vendor/image-size",
    "jsdom": "24.1.3",
    "postcss": "8.5.25",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "rollup-plugin-visualizer": "5.12.0",
    "sprintf-js": "file:./vendor/sprintf-js",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vite-plugin-dts": "4.5.4",
    "vitest": "4.1.11"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint src",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check:sibling-deps": "node scripts/check-sibling-dependencies.mjs",
    "test:dependency-shims": "node vendor/bigint-buffer/test.mjs && node vendor/image-size/test.mjs",
    "ci:checks": "npm run lint && npm run type-check && npm test && npm run check:sibling-deps && npm run test:dependency-shims",
    "analyze": "ANALYZE=true vite build",
    "verify:exports": "node scripts/verify-package-exports.mjs",
    "verify:browser-admin": "node --test scripts/browser-admin-bundle.test.mjs",
    "prepare": "cd .. && test -e .git && husky ui/.husky || true"
  },
  "overrides": {
    "bigint-buffer": "file:./vendor/bigint-buffer",
    "brace-expansion": "5.0.12",
    "braces": "npm:@dieub/braces-depth-guard@3.0.3-pn.3",
    "elliptic": "npm:@soatok/elliptic-to-noble@9999.0.0",
    "esbuild": "0.28.1",
    "fast-uri": "3.1.8",
    "glob": "13.0.6",
    "image-size": "$image-size",
    "js-yaml": "4.3.2",
    "minimatch": "10.2.4",
    "postcss-selector-parser": "7.1.6",
    "rimraf": "5.0.10",
    "source-map-js": "1.2.2",
    "sprintf-js": "$sprintf-js",
    "test-exclude": "8.0.0",
    "uuid@<11.1.1": "11.1.1"
  },
  "packageManager": "npm@11.13.0",
  "private": true
}
