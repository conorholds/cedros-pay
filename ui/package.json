{
  "name": "@cedros/pay-react",
  "version": "3.0.0",
  "description": "React frontend library for Cedros Pay - unified Stripe and Solana x402 payments",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "react-native": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./payments": {
      "react-native": "./src/payments.ts",
      "types": "./dist/payments.d.ts",
      "import": "./dist/payments.mjs",
      "require": "./dist/payments.js"
    },
    "./checkout": {
      "types": "./dist/checkout.d.ts",
      "import": "./dist/checkout.mjs",
      "require": "./dist/checkout.js"
    },
    "./admin": {
      "react-native": "./src/admin.ts",
      "types": "./dist/admin.d.ts",
      "import": "./dist/admin.mjs",
      "require": "./dist/admin.js"
    },
    "./autosave": {
      "react-native": "./src/autosave/index.ts",
      "types": "./dist/autosave/index.d.ts",
      "import": "./dist/autosave/index.mjs",
      "require": "./dist/autosave/index.js"
    },
    "./admin/register": {
      "react-native": "./src/admin/register.ts",
      "types": "./dist/admin/register.d.ts",
      "import": "./dist/admin/register.mjs",
      "require": "./dist/admin/register.js"
    },
    "./web/register": {
      "react-native": "./src/web/register.ts",
      "types": "./dist/web/register.d.ts",
      "import": "./dist/web/register.mjs",
      "require": "./dist/web/register.js"
    },
    "./crypto-only": {
      "react-native": "./src/crypto-only.ts",
      "types": "./dist/crypto-only.d.ts",
      "import": "./dist/crypto-only.mjs",
      "require": "./dist/crypto-only.js"
    },
    "./telemetry": {
      "react-native": "./src/telemetry.ts",
      "types": "./dist/telemetry.d.ts",
      "import": "./dist/telemetry.mjs",
      "require": "./dist/telemetry.js"
    },
    "./testing": {
      "react-native": "./src/testing/index.ts",
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.mjs",
      "require": "./dist/testing/index.js"
    },
    "./style.css": "./dist/pay-react.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "keywords": [
    "payments",
    "stripe",
    "solana",
    "x402",
    "crypto",
    "react",
    "stablecoins"
  ],
  "author": "Cedros Pay Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/conorholds/cedros-pay.git",
    "directory": "ui"
  },
  "bugs": {
    "url": "https://github.com/conorholds/cedros-pay/issues"
  },
  "homepage": "https://github.com/conorholds/cedros-pay/tree/main/ui#readme",
  "peerDependencies": {
    "@cedros/login-react": ">=0.0.4",
    "@solana/spl-token": "^0.4.14",
    "@solana/wallet-adapter-base": "^0.9.23",
    "@solana/wallet-adapter-react": "^0.15.35",
    "@solana/wallet-adapter-phantom": "^0.9.29",
    "@solana/wallet-adapter-react-ui": "^0.9.39",
    "@solana/wallet-adapter-solflare": "^0.6.33",
    "@solana/web3.js": "^1.95.0",
    "@meteora-ag/dlmm": ">=1.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "vitest": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "@cedros/login-react": {
      "optional": true
    },
    "@solana/spl-token": {
      "optional": true
    },
    "@solana/wallet-adapter-base": {
      "optional": true
    },
    "@solana/wallet-adapter-react": {
      "optional": true
    },
    "@solana/wallet-adapter-phantom": {
      "optional": true
    },
    "@solana/wallet-adapter-react-ui": {
      "optional": true
    },
    "@solana/wallet-adapter-solflare": {
      "optional": true
    },
    "@solana/web3.js": {
      "optional": true
    },
    "@meteora-ag/dlmm": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "dependencies": {
    "@noble/hashes": "1.8.0",
    "@stripe/stripe-js": "4.10.0",
    "bs58": "6.0.0",
    "js-base64": "3.7.8"
  },
  "devDependencies": {
    "@cedros/login-react": "0.0.4",
    "@eslint/js": "9.39.4",
    "@solana/spl-token": "0.4.14",
    "@solana/wallet-adapter-base": "0.9.27",
    "@solana/wallet-adapter-react": "0.15.39",
    "@solana/wallet-adapter-phantom": "0.9.29",
    "@solana/wallet-adapter-react-ui": "0.9.39",
    "@solana/wallet-adapter-solflare": "0.6.33",
    "@solana/web3.js": "1.98.4",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "14.3.1",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.10.0",
    "@types/react": "18.3.26",
    "@types/react-dom": "18.3.7",
    "@typescript-eslint/eslint-plugin": "8.60.1",
    "@typescript-eslint/parser": "8.60.1",
    "@vitejs/plugin-react": "4.7.0",
    "@vitest/coverage-v8": "4.1.0",
    "autoprefixer": "10.4.23",
    "bigint-buffer": "file:./vendor/bigint-buffer",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.6.0",
    "husky": "9.1.7",
    "jsdom": "24.1.3",
    "postcss": "8.5.15",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "rollup-plugin-visualizer": "5.12.0",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "vite": "7.3.5",
    "vite-plugin-dts": "4.5.4",
    "vitest": "4.1.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint src",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check:checkout-contract": "node scripts/sync-checkout-contract-fixtures.mjs --check",
    "check:i18n": "node scripts/validate-i18n.mjs",
    "check:duplication": "node scripts/check-duplication-drift.mjs --ci",
    "check:duplication:report": "node scripts/check-duplication-drift.mjs",
    "check:sibling-deps": "node scripts/check-sibling-dependencies.mjs",
    "test:dependency-shims": "node vendor/bigint-buffer/test.mjs",
    "ci:checks": "npm run check:checkout-contract && npm run lint && npm run type-check && npm test && npm run check:i18n && npm run check:duplication && npm run check:sibling-deps && npm run test:dependency-shims",
    "analyze": "ANALYZE=true vite build",
    "verify:exports": "node scripts/verify-package-exports.mjs",
    "verify:consumers": "node scripts/verify-checkout-consumer.mjs",
    "prepack": "npm run check:checkout-contract && npm run build && npm run verify:exports"
  },
  "overrides": {
    "bigint-buffer": "file:./vendor/bigint-buffer",
    "@solflare-wallet/sdk": {
      "uuid": "11.1.1"
    },
    "elliptic": "npm:@soatok/elliptic-to-noble@9999.0.0",
    "esbuild": "0.28.1",
    "jayson": {
      "uuid": "11.1.1"
    },
    "js-yaml": "4.2.0",
    "minimatch": "10.2.4",
    "react-native": "0.77.3",
    "rpc-websockets": {
      "uuid": "14.0.0"
    }
  },
  "directories": {
    "doc": "docs",
    "example": "examples"
  },
  "packageManager": "npm@11.13.0"
}